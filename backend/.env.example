# Runtime environment: local | staging | production
ENVIRONMENT=local

# CORS allowed origins, comma-separated.
# The Vite frontend runs on port 5173 (see ../dev.sh).
CORS_ORIGINS=http://localhost:5173

# Postgres connection string (asyncpg driver).
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> "URI",
# then replace the "postgresql://" scheme with "postgresql+asyncpg://".
# Use the connection pooler host (port 6543) and URL-encode the password.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Static secret the frontend must send in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
