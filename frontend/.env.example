# Base URL of the FastAPI backend.
# Locally the backend runs on port 8000 (see ../dev.sh).
VITE_API_URL=http://localhost:8000

# Must match API_KEY in backend/.env. Note: Vite inlines VITE_* vars into the
# browser bundle, so this is a gate for a single-user app, not a shared secret.
VITE_API_KEY=
