// Monorepo: frontend (Vite) y backend (FastAPI).
[
  {
    "label": "Backend: FastAPI (uvicorn)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "uvicorn",
    "args": ["main:app", "--reload", "--port", "8000"],
    "cwd": "$ZED_WORKTREE_ROOT/backend"
  },
  {
    "label": "Backend: archivo actual",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT/backend"
  },
  {
    "label": "Frontend: Vite dev server",
    "adapter": "JavaScript",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/frontend/node_modules/.bin/vite",
    "cwd": "$ZED_WORKTREE_ROOT/frontend",
    "console": "integratedTerminal"
  }
]
