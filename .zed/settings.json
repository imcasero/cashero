{
  "languages": {
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "tailwindcss-language-server"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "tailwindcss-language-server"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "TSX": {
      "language_servers": ["vtsls", "biome", "tailwindcss-language-server"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": { "language_server": { "name": "ruff" } },
      "format_on_save": "on",
      "tab_size": 4
    }
  }
}
